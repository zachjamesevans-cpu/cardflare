# CardFlare environment variables.
# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (required for the waitlist to accept submissions) ---
# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Anon key. Safe to expose to the browser; not currently used by the splash
# page, which writes only through the server action below.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. SERVER ONLY — bypasses Row Level Security.
# Never prefix this with NEXT_PUBLIC_ and never reference it in a client component.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
# Canonical origin used for metadata, sitemap and robots.
# Leave unset on Vercel previews to fall back to the deployment URL.
NEXT_PUBLIC_SITE_URL=https://cardflare.gg

# --- Social sign-in (optional) ---
# Comma-separated list of providers that are ACTUALLY configured under
# Supabase → Authentication → Providers. Recognised: google, apple.
#
# This is a claim about what you set up there — nothing here can verify it, so
# naming a provider you have not configured produces a button that sends people
# to a Supabase error page. Leave it unset and no social buttons render at all,
# which is the honest default.
#
# Deliberately not NEXT_PUBLIC_: it is read only on the server, and a
# NEXT_PUBLIC_ value would be inlined at build time and need a redeploy rather
# than a restart to change.
AUTH_PROVIDERS=

# --- Email (optional) ---
# Outbound transactional email — waitlist confirmations and store invites.
# Leave both unset and no email is sent; everything else works exactly as
# before, so an unconfigured install is inert rather than broken.
# Both are required together — one without the other is treated as unconfigured.
# The from address must be on a domain verified with the provider, or mail
# will be rejected or land in spam. See docs/DEPLOYMENT.md.
RESEND_API_KEY=
CARDFLARE_FROM_EMAIL=CardFlare <hello@cardflare.gg>

# ---------------------------------------------------------------------------
# Card images
# ---------------------------------------------------------------------------
# Whether provider-supplied card artwork is rendered.
#
# When false, no <img> is rendered at all and the CardFlare placeholder is
# shown instead — the flag is not merely a visual preference, it decides
# whether a third party is contacted.
#
# When true, only URLs the provider actually returned are rendered, and only
# from the hosts allow-listed in next.config.ts. URLs are never constructed or
# guessed from a pattern. They are served through Next's image optimiser, so
# the image is fetched once by the server, resized, and cached — rather than
# every visitor's browser fetching a full-size JPEG from the provider.
#
# NEXT_PUBLIC_ values are inlined at build time. Changing this needs a
# redeploy, not just a restart. See docs/CARD_DATA.md.
NEXT_PUBLIC_ENABLE_CARD_IMAGES=true

# The demo world, for App Store screenshots. Copy to .env.demo (gitignored)
# and fill it from a SEPARATE Supabase project, never production: the
# demo commands refuse the production project. See supabase/demo/README.md.

# Supabase dashboard of the demo project, Project Settings, API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The same dashboard, Connect, "Session pooler" connection string, with the
# database password you chose put in place of [YOUR-PASSWORD].
DEMO_DATABASE_URL=

# The password every demo account signs in with, 8 characters or more.
DEMO_PASSWORD=
# The hero's name on the profile and in the room.
DEMO_HERO_NAME=Zach

# The app, pointed at the website on this Mac (mobile/app.config.js).
CARDFLARE_DEMO=1
DEMO_API_BASE=http://localhost:3000

# The website on this Mac. Anything left unset here is read from
# .env.local instead, so the senders are switched off on purpose.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_CARD_IMAGES=true
RESEND_API_KEY=disabled-in-demo
STRIPE_SECRET_KEY=disabled-in-demo
ANTHROPIC_API_KEY=disabled-in-demo

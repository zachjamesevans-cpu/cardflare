{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh repo view:*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(npm run:*)",
      "Bash(npm run *)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npx tsc:*)",
      "Bash(npx prettier:*)",
      "Bash(npx vitest:*)",
      "Bash(npx expo:*)",
      "Bash(npx tsc *)",
      "Bash(npx prettier *)",
      "Bash(npx vitest *)",
      "Bash(npx expo *)",
      "Bash(xcrun:*)",
      "Bash(xcrun *)",
      "Bash(open -a Simulator)",
      "Bash(maestro test:*)",
      "Bash(maestro test *)"
    ],
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(gh pr merge *)",
      "Bash(npx eas-cli:*)",
      "Bash(npx eas-cli *)",
      "Bash(eas build:*)",
      "Bash(eas submit:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push --force *)",
      "Bash(git push -f:*)",
      "Bash(git push -f *)",
      "Bash(git push --delete:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -rf *)"
    ]
  }
}

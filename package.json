{
  "name": "cardflare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-rive-wasm.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-rive-wasm.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "cosmetics:svg": "tsx scripts/build-cosmetic-svgs.ts",
    "cosmetics:art": "node scripts/extract-cosmetic-art.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "cards:probe": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/probe-optcgapi.ts",
    "cards:sync:onepiece": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/sync-onepiece.ts"
  },
  "dependencies": {
    "@rive-app/canvas": "^2.40.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "sucrase": "^3.35.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.2",
    "@img/sharp-linux-x64": "0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
